---
// src/pages/projects/[...id].astro
import Layout from "../../layouts/Layout.astro";
import BackButton from "../../components/BackButton.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const allProjects: CollectionEntry<"projects">[] = await getCollection("projects");

  return allProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const imageUrl = project.data.image?.url;
const imageAlt = project.data.image?.alt || project.data.title;
---

<Layout title={project.data.title} description={project.data.description}>
  <div class="project-details">
    <div class="project-details__back-wrapper">
      <BackButton fallbackHref="/projects" />
    </div>

    <header class="project-details__header">
      <div class="project-details__header-info">
        <h1 class="project-details__title">
          Śląski Diament Posłuszeństwa 1️⃣
        </h1>
        <h2>{project.data.description}</h2>
        <p class="project-details__description">{project.data.description}</p>
      </div>

      <div class="project-details__actions">
        {
          project.data.githubUrl && (
            <ButtonPrimary
              href={project.data.githubUrl}
              text="Kod źródłowy"
              target="_blank"
              rel="noopener noreferrer"
              class="project-details__btn"
            />
          )
        }
        {
          project.data.liveUrl && (
            <ButtonSecondary
              href={project.data.liveUrl}
              text="Zobacz na żywo"
              target="_blank"
              rel="noopener noreferrer"
              class="project-details__btn"
            />
          )
        }
      </div>
    </header>

    <div class="project-details__body">
      <article class="project-details__content">
        <Content />
      </article>

      {
        imageUrl && (
          <aside class="project-details__sidebar">
            <div class="project-details__image-wrapper">
              <Image
                src={imageUrl}
                alt={imageAlt}
                inferSize={true}
                class="project-details__main-image"
                loading="eager"
              />
            </div>
          </aside>
        )
      }
    </div>

    {
      project.data.gallery && project.data.gallery.length > 0 && (
        <section class="project-details__gallery" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading" class="project-details__gallery-title">
            Galeria zdjęć
          </h2>

          <div class="project-details__gallery-grid">
            {project.data.gallery.map((img) => (
              <div class="project-details__gallery-item">
                <Image
                  src={img.url}
                  alt={img.alt || `Zdjęcie w galerii ${project.data.title}`}
                  inferSize={true}
                  class="project-details__gallery-image"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style lang="scss">
  @use "sass:color";
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  .project-details {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem;

    &__back-wrapper {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }

    &__header {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px dashed color.mix($color-text, $color-bg, 30%);

      @include respond-to('md') {
        flex-direction: row;
        align-items: center;
      }
    }

    &__header-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 36rem;
    }

    &__title {
      font-size: 1.875rem;
      font-weight: 800;
      text-transform: uppercase;
      line-height: 1.2;
      color: $color-primary;

      @include respond-to('md') {
        font-size: 3rem;
      }
    }

    &__description {
      font-size: 1.125rem;
      line-height: 1.6;
      color: $color-text;
    }

    &__actions {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;

      @include respond-to('sm') {
        flex-direction: row;
        width: auto;
      }
    }

    :global(.project-details__btn) {
      width: 100%;

      @include respond-to('sm') {
        width: auto;
      }
    }

    // Układ dwukolumnowy (Treść + Sticky Obrazek)
    &__body {
      display: flex;
      flex-direction: column-reverse;
      gap: 3rem;
      margin-top: 2.5rem;
      align-items: flex-start;

      @include respond-to('lg') {
        flex-direction: row;
      }
    }

    &__content {
      width: 100%;
      font-size: 1.125rem;
      line-height: 1.7;
      color: $color-text;

      @include respond-to('lg') {
        width: 65%;
      }

      // Stylizowanie wyrenderowanej zawartości z kolekcji (MDX/Content)
      :global(h2) {
        font-size: 2rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }

      :global(p) {
        margin-bottom: 1.25rem;
      }
    }

    &__sidebar {
      width: 100%;
      flex-shrink: 0;

      @include respond-to('lg') {
        width: 35%;
        position: sticky;
        top: 2rem;
      }
    }

    &__image-wrapper {
      width: 100%;
      aspect-ratio: 610 / 400;
      overflow: hidden;
      border-radius: 1rem;
    }

    &__main-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    // Galeria
    &__gallery {
      margin-top: 3rem;
      margin-bottom: 4.5rem;
      padding-top: 3rem;
      padding-bottom: 3rem;
      border-bottom: 1px dashed color.mix($color-text, $color-bg, 30%);
    }

    &__gallery-title {
      font-size: 1.5rem;
      font-weight: 800;
      text-transform: uppercase;
      color: $color-primary;
      margin-bottom: 2rem;

      @include respond-to('md') {
        font-size: 1.875rem;
      }
    }

    &__gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    &__gallery-item {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 1rem;
      background-color: color.mix($color-text, $color-bg, 5%);
    }

    &__gallery-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform $transition-base;

      &:hover {
        transform: scale(1.05);
      }
    }
  }
</style>