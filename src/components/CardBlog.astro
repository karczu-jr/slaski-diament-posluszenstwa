---
// src/components/Card.astro
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props;

const href = `/${entry.collection}/${entry.id}`;
const imageAlt = entry.data.image?.alt || entry.data.title;
const imageUrl = entry.data.image?.url || `https://placehold.co/600x400?text=${encodeURIComponent(entry.data.title)}`;

const formattedDate = entry.data.date
  ? entry.data.date instanceof Date
    ? entry.data.date.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" })
    : entry.data.date
  : null;
---

<article class="card">
  <a href={href} class="card__link" data-card-link>
    <!-- Kursor podążający za ruchem myszy (element dekoracyjny) -->
    <div class="card__cursor-circle" data-cursor-circle aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="card__cursor-icon"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 7h10v10"></path>
        <path d="M7 17 17 7"></path>
      </svg>
    </div>

    <!-- Kontener miniaturki obrazu -->
    <div class="card__image-wrapper">
      <img
        src={imageUrl}
        alt={imageAlt}
        class="card__image"
        width={610}
        height={400}
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Treść karty -->
    <div class="card__content">
      <h3 class="card__title">
        {entry.data.title}
      </h3>

      {
        (formattedDate || entry.data.location) && (
          <p class="card__meta">
            {formattedDate && (
              <span class="card__meta-item">
                <span aria-hidden="true">📅</span>
                <time datetime={entry.data.date instanceof Date ? entry.data.date.toISOString() : undefined}>
                  {formattedDate}
                </time>
              </span>
            )}
            {entry.data.location && (
              <span class="card__meta-item">
                <span aria-hidden="true">📍</span>
                <span>{entry.data.location}</span>
              </span>
            )}
          </p>
        )
      }

      {
        entry.data.description && (
          <p class="card__description">
            {entry.data.description}
          </p>
        )
      }
    </div>
  </a>
</article>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/mixins" as *;

  .card {
    position: relative;
    width: 100%;
    border-bottom: 1px dashed mix($color-text, $color-bg, 20%);
    padding-bottom: 2rem;
    margin-bottom: 2rem;

    &__link {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      text-decoration: none;
      color: inherit;
      position: relative;

      @include respond-to("md") {
        flex-direction: row;
        gap: 3rem;
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 8px;
        border-radius: 1.5rem;
      }
    }

    // Efekt kółka kursora
    &__cursor-circle {
      position: absolute;
      width: 75px;
      height: 75px;
      background-color: $color-primary;
      border: 1px dashed mix($color-text, $color-bg, 30%);
      border-radius: 50%;
      pointer-events: none;
      display: grid;
      place-items: center;
      transform: translate(-50%, -50%);
      opacity: 0;
      transition: opacity 200ms ease;
      z-index: 10;

      // Wyłączenie kółka dla osób preferujących redukcję ruchu lub ekrany dotykowe (A11y)
      @media (prefers-reduced-motion: reduce), (pointer: coarse) {
        display: none !important;
      }
    }

    &__cursor-icon {
      width: 2.5rem;
      height: 2.5rem;
      color: $color-accent;
    }

    // Sekcja obrazu
    &__image-wrapper {
      width: 100%;
      aspect-ratio: 610 / 400;
      overflow: hidden;
      border: 1px dashed mix($color-text, $color-bg, 20%);
      border-radius: 1.5rem;

      @include respond-to("md") {
        max-width: 610px;
      }
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform $transition-base;
    }

    &__link:hover &__image {
      transform: scale(1.02);
    }

    // Treść karty
    &__content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      text-align: center;
      max-width: 36rem;
      width: 100%;

      @include respond-to("md") {
        text-align: left;
      }
    }

    &__title {
      font-size: 1.5rem;
      // font-weight: 800;
      text-transform: uppercase;
      line-height: 1.2;
      color: $color-text;
      
      // Ograniczenie do 2 linijek tekstu
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;

      @include respond-to("md") {
        font-size: 2.25rem;
      }
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: mix($color-text, $color-bg, 70%);

      @include respond-to("md") {
        justify-content: flex-start;
        font-size: 1.25rem;
      }
    }

    &__meta-item {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    &__description {
      font-size: 1.125rem;
      line-height: 1.5;
      color: mix($color-text, $color-bg, 80%);

      // Ograniczenie do 3 linijek tekstu
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;

      @include respond-to("md") {
        font-size: 1.5rem;
      }
    }
  }
</style>

<script>
  // Zoptymalizowana obsługa płynnego kursora z klasami zamiast selektorów ID
  const initCardCursors = () => {
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const cardLinks = document.querySelectorAll<HTMLElement>('[data-card-link]');

    cardLinks.forEach((cardLink) => {
      const circle = cardLink.querySelector<HTMLElement>('[data-cursor-circle]');
      if (!circle) return;

      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let isHovering = false;
      let animationFrameId: number | null = null;

      const animateCursor = () => {
        if (!isHovering) return;
        const speed = 0.15;
        currentX += (targetX - currentX) * speed;
        currentY += (targetY - currentY) * speed;

        circle.style.left = `${currentX}px`;
        circle.style.top = `${currentY}px`;

        animationFrameId = requestAnimationFrame(animateCursor);
      };

      cardLink.addEventListener('mouseenter', (e: MouseEvent) => {
        const rect = cardLink.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        currentX = targetX;
        currentY = targetY;
        circle.style.left = `${currentX}px`;
        circle.style.top = `${currentY}px`;
        circle.style.opacity = '1';
        isHovering = true;
        
        if (!animationFrameId) {
          animateCursor();
        }
      });

      cardLink.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = cardLink.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
      });

      cardLink.addEventListener('mouseleave', () => {
        isHovering = false;
        circle.style.opacity = '0';
        if (animationFrameId) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initCardCursors);
</script>