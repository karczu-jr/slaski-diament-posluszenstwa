---
// src/components/FormattedDate.astro
interface Props {
  date: Date;
  class?: string;
}

const { date, class: className = '' } = Astro.props;

// Bezpieczne przygotowanie daty dla czytników i wyszukiwarek (ISO 8601)
const isoDate = date.toISOString();

// Formatowanie czytelne dla użytkownika (np. 12 maja 2026)
const formattedDate = date.toLocaleDateString("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<time datetime={isoDate} class:list={['formatted-date', className]}>
  {formattedDate}
</time>

<style lang="scss">
  @use '../styles/variables' as *;

  .formatted-date {
    display: inline-block;
    font-size: 0.875rem;
    color: mix($color-text, $color-bg, 70%);
    font-weight: 500;
  }
</style>