---
// src/components/Contact.astro
import { SOCIALS } from "../consts";
import ButtonPrimary from "./ButtonPrimary.astro";
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="contact__title">Masz pytania?<br>Napisz do nas 💎</h2>

  <div class="contact__grid">
    <div class="contact__info">
      <p class="contact__description">
        Chcesz zapytać o zawody Obedience Śląski Diament Posłuszeństwa, dołączyć do grona partnerów, czy upewnić się co do szczegółów swojego startu? Napisz do nas!
      </p>

      <ul class="contact__socials-list" aria-label="Social media links">
        {
          SOCIALS.map((link) => (
            <li class="contact__socials-item">
              <a
                href={link.HREF}
                target="_blank"
                rel="noopener noreferrer"
                class="contact__socials-link"
              >
                {link.NAME}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <form class="contact__form" action="#" method="POST" novalidate>
      <div class="contact__form-row">
        <div class="contact__field">
          <input
            type="text"
            id="name"
            name="name"
            class="contact__input"
            placeholder=" "
            required
            aria-required="true"
          />
          <label for="name" class="contact__label">Imię i nazwisko*</label>
        </div>

        <div class="contact__field">
          <input
            type="email"
            id="email"
            name="email"
            class="contact__input"
            placeholder=" "
            required
            aria-required="true"
          />
          <label for="email" class="contact__label">Email*</label>
        </div>
      </div>

      <div class="contact__field">
        <textarea
          id="message"
          name="message"
          rows="6"
          class="contact__textarea"
          placeholder=" "
          required
          aria-required="true"></textarea>
        <label for="message" class="contact__label">Wiadomość*</label>
      </div>

      <div class="contact__actions">
        <ButtonPrimary 
          type="submit" 
          text="Wyślij wiadomość" 
          class="contact__submit-btn" 
        />
      </div>
    </form>
  </div>
</section>

<style lang="scss">
  @use "sass:color";
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .contact {
    padding-top: 4rem;
    padding-bottom: 4rem;

    &__title {
      margin-bottom: 2.5rem;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      align-items: start;
      gap: 2.5rem;

      @include respond-to('md') {
        grid-template-columns: repeat(2, 1fr);
        gap: 3rem;
      }
    }

    &__info {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    &__description {
      max-width: 36rem;
    }

    &__socials-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    &__socials-link {
      font-size: 1.25rem;
      color: $color-text;
      text-decoration: underline;
      transition: color $transition-base;

      &:hover {
        color: $color-accent;
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 3px;
        border-radius: 0.25rem;
      }
    }

    &__form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    &__form-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;

      @include respond-to('sm') {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    &__field {
      position: relative;
      width: 100%;
    }

    &__input,
    &__textarea {
      width: 100%;
      height: 62px;
      padding: 1rem 1.25rem;
      font-size: 1.125rem;
      color: $color-text;
      background-color: transparent;
      border: 1px dashed $color-text;
      border-radius: 1.5rem;
      outline: none;
      transition: border-color $transition-base, background-color $transition-base;

      &:focus {
        border-color: $color-accent;
        border-style: solid;
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 2px;
      }
    }

    &__textarea {
      resize: vertical;
      min-height: 150px;
    }

    &__label {
      position: absolute;
      left: 1.25rem;
      top: 1rem;
      font-size: 1.125rem;
      color: color.mix($color-text, $color-bg, 60%);
      pointer-events: none;
      transition: all 200ms ease-in-out;
      background-color: transparent;
      padding: 0 0.25rem;
    }

    &__input:focus ~ &__label,
    &__input:not(:placeholder-shown) ~ &__label,
    &__textarea:focus ~ &__label,
    &__textarea:not(:placeholder-shown) ~ &__label {
      top: -0.625rem;
      font-size: 0.875rem;
      color: $color-accent;
      background-color: $color-bg;
      font-weight: 600;
    }

    &__actions {
      display: flex;
      justify-content: flex-start;
    }

    :global(.contact__submit-btn) {
      width: 100%;

      @include respond-to('sm') {
        width: auto;
      }
    }
  }
</style>