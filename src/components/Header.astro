---
// src/components/Header.astro
import { SITE } from "../consts";
import Logo from "./Logo.astro";

const links = [
  { name: "Home", href: "/", target: "_self" },
  { name: "Newsy", href: "/blog", target: "_self" },
  { name: "Zawody", href: "/projects", target: "_self" },
  { name: "O nas", href: "/about", target: "_self" },
  { name: "Kontakt", href: "/contact", target: "_self" },
];

const pathname = new URL(Astro.request.url).pathname;
// Strona główna: menu bez tła i bez logo, przewija się razem z hero;
// po przewinięciu hero wysuwa się z góry w zwykłej (przyklejonej) formie.
const isHome = pathname === "/";
---

<header class:list={["header", { "header--home": isHome }]} data-home-header={isHome ? "" : undefined}>
  <div class="header__container">
    <a href="/" class="header__logo" aria-label={`${SITE.TITLE} – strona główna`}>
      <Logo variant="compact" />
    </a>

    <!-- Nawigacja Desktopowa -->
    <nav class="header__nav header__nav--desktop" aria-label="Nawigacja główna">
      <ul class="header__list">
        {
          links.map((link) => {
            const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
            return (
              <li class="header__item">
                <a
                  href={link.href}
                  target={link.target}
                  class:list={['header__link', { 'header__link--active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.name}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Przycisk Hamburger dla urządzeń mobilnych -->
    <button
      id="menu-toggle"
      class="header__toggle"
      aria-label="Otwórz menu nawigacji"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="header__toggle-line" aria-hidden="true"></span>
      <span class="header__toggle-line" aria-hidden="true"></span>
      <span class="header__toggle-line" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Nawigacja Mobilna -->
  <div id="menu-mobile" class="header__mobile-menu" aria-hidden="true">
    <nav class="header__nav header__nav--mobile" aria-label="Nawigacja mobilna">
      <ul class="header__mobile-list">
        {
          links.map((link) => {
            const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
            return (
              <li class="header__mobile-item">
                <a
                  href={link.href}
                  target={link.target}
                  class:list={['header__mobile-link', { 'header__mobile-link--active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.name}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    background-color: rgba($color-bg, 0.8);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid mix($color-text, $color-bg, 10%);

    // ---------- Tryb strony głównej ----------
    // Stan początkowy: część strony nad hero (przewija się), bez tła, ramki i logo
    &--home:not(.is-docked) {
      position: absolute;
      background-color: transparent;
      backdrop-filter: none;
      border-bottom-color: transparent;

      .header__logo {
        visibility: hidden; // zachowuje miejsce, ukryte też dla czytników i Tab
      }
    }

    // Po przewinięciu hero: zwykły wygląd, wjazd z góry
    &--home.is-docked {
      animation: header-slide-in 0.35s cubic-bezier(0.22, 1, 0.36, 1);

      @media (prefers-reduced-motion: reduce) {
        animation: none;
      }
    }

    @keyframes header-slide-in {
      from {
        transform: translateY(-100%);
      }
      to {
        transform: translateY(0);
      }
    }

    &__container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1280px;
      margin: 0 auto;
      padding: 1.25rem 1.5rem;
    }

    &__logo {
      display: inline-flex;
      align-items: center;
      color: $color-primary;
      text-decoration: none;
      line-height: 1;

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 4px;
        border-radius: 0.25rem;
      }
    }

    // Nawigacja Desktopowa
    &__nav--desktop {
      display: none;

      @include respond-to('md') {
        display: block;
      }
    }

    &__list {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
    }

    &__link {
      color: $color-text;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 400;
      padding-bottom: 0.25rem;
      border-bottom: 2px solid transparent;
      transition: color $transition-base, border-color $transition-base;

      &:hover {
        color: $color-accent;
        border-bottom-style: dashed;
        border-bottom-color: $color-accent;
      }

      &--active {
        color: $color-accent;
        font-weight: 500;
        border-bottom: 2px solid $color-accent;
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 4px;
        border-radius: 0.25rem;
      }
    }

    // Przycisk Hamburger dla WCAG 2.2 (min. 44x44px)
    &__toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
      width: 44px;
      height: 44px;
      padding: 0;
      border: none;
      background: transparent;
      cursor: pointer;

      @include respond-to('md') {
        display: none;
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 2px;
        border-radius: 0.25rem;
      }
    }

    &__toggle-line {
      position: absolute;
      width: 24px;
      height: 3px;
      background-color: $color-text;
      border-radius: 2px;
      transition: transform $transition-base, opacity $transition-base, top $transition-base;

      &:nth-child(1) { top: 12px; }
      &:nth-child(2) { top: 20px; }
      &:nth-child(3) { top: 28px; }
    }

    // Stan aktywny hamburgera
    &__toggle.is-active &__toggle-line {
      &:nth-child(1) {
        top: 20px;
        transform: rotate(45deg);
      }
      &:nth-child(2) {
        opacity: 0;
      }
      &:nth-child(3) {
        top: 20px;
        transform: rotate(-45deg);
      }
    }

    // Panel Nawigacji Mobilnej
    &__mobile-menu {
      display: block;
      width: 100%;
      padding: 1.5rem;
      background-color: $color-bg;
      border-bottom: 1px solid mix($color-text, $color-bg, 10%);

      // Stan ukryty dla urządzeń mobilnych
      &[aria-hidden="true"] {
        display: none;
      }

      @include respond-to('md') {
        display: none !important;
      }
    }

    &__mobile-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      list-style: none;
    }

    &__mobile-link {
      font-size: 1.25rem;
      font-weight: 600;
      color: $color-text;
      text-decoration: none;

      &:hover,
      &--active {
        color: $color-accent;
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 2px;
      }
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuMobile = document.getElementById("menu-mobile");
    const toggle = document.getElementById("menu-toggle");

    toggle?.addEventListener("click", () => {
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      const newExpandedState = !isExpanded;

      toggle.setAttribute("aria-expanded", String(newExpandedState));
      toggle.setAttribute("aria-label", newExpandedState ? "Zamknij menu nawigacji" : "Otwórz menu nawigacji");
      toggle.classList.toggle("is-active", newExpandedState);

      if (menuMobile) {
        menuMobile.setAttribute("aria-hidden", String(!newExpandedState));
      }
    });

    // Strona główna: przyklej menu dopiero, gdy hero w całości zniknie u góry ekranu
    const header = document.querySelector<HTMLElement>("[data-home-header]");
    const hero = document.querySelector(".hero");
    if (header && hero) {
      const observer = new IntersectionObserver(([entry]) => {
        const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.bottom <= 0;
        header.classList.toggle("is-docked", scrolledPast);
      });
      observer.observe(hero);
    }
  });
</script>