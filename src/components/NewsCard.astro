---
// src/components/NewsCard.astro
// Karta newsa (wersja 5) – wspólna dla strony głównej, listy newsów i "Czytaj także".
// - "featured": duża, pozioma karta (najnowszy wpis)
// - "compact":  mniejsza karta do siatki
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  entry: CollectionEntry<"blog">;
  variant?: "featured" | "compact";
  /** Plakietka na zdjęciu, np. "Najnowsze" (tylko featured) */
  badge?: string;
  /** Poziom nagłówka tytułu – h2 na liście, h3 w sekcjach */
  headingLevel?: 2 | 3;
}

const { entry, variant = "compact", badge, headingLevel = 3 } = Astro.props;
const { title, description, date, tags } = entry.data;
const H = `h${headingLevel}` as "h2" | "h3";

const href = `/blog/${entry.id}`;
const featured = variant === "featured";
const tag = tags?.[0];
// Zdjęcie karty: okładka, a gdy jej brak – pierwsze zdjęcie z galerii wpisu
const cover = entry.data.image ?? entry.data.gallery?.[0];
const formattedDate = date?.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---

<article class:list={["news-card", `news-card--${variant}`]} data-tag={tag}>
  <a href={href} class="news-card__link">
    <span class="news-card__media">
      {
        cover ? (
          <Image
            src={cover.url}
            alt=""
            widths={featured ? [640, 960, 1400] : [400, 600, 900]}
            sizes={featured ? "(min-width: 768px) 60vw, 100vw" : "(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"}
            class="news-card__img"
            loading={featured ? "eager" : "lazy"}
          />
        ) : (
          <span class="news-card__fallback" aria-hidden="true">
            ◆
          </span>
        )
      }
      {featured && badge && <span class="news-card__badge">{badge}</span>}
    </span>

    <span class="news-card__body">
      <span class="news-card__meta">
        {tag && <span class="news-card__tag">{tag}</span>}
        {date && <time datetime={date.toISOString()}>{formattedDate}</time>}
      </span>
      <H class="news-card__title">{title}</H>
      {description && <span class="news-card__desc">{description}</span>}
      <span class="news-card__more">Czytaj dalej <span class="nudge" aria-hidden="true">👉</span></span>
    </span>
  </a>
</article>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/mixins" as *;
  @use "../styles/home" as *;

  .news-card {
    display: flex;
    width: 100%;

    &__link {
      display: flex;
      flex-direction: column;
      width: 100%;
      text-decoration: none;
      color: inherit;
      background: #ffffff;
      border-radius: $home-radius;
      overflow: hidden;
      @include home-card-hover;
    }

    &__media {
      position: relative;
      display: block;
      aspect-ratio: 3 / 2;
      overflow: hidden;
    }

    &__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__fallback {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      color: rgba($color-accent, 0.6);
      background:
        radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px) 0 0 / 14px 14px,
        linear-gradient(135deg, #eef3fd, #f1f1f1);
    }

    &__badge {
      position: absolute;
      top: 16px;
      left: 16px;
      font-family: $font-family-heading;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #ffffff;
      background: $color-primary;
      padding: 5px 12px;
      border-radius: 999px;
    }

    &__body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 20px 24px 24px;
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: $home-muted;
    }

    &__tag {
      font-family: $font-family-heading;
      font-size: 12px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: $color-accent;
      background: $home-accent-soft;
      padding: 3px 10px;
      border-radius: 999px;
    }

    &__title {
      @include heading-reset;
      font-family: $font-family-heading;
      font-weight: 600;
      font-size: 20px;
      line-height: 1.3;
      color: $color-primary;
    }

    &__desc {
      font-size: 15px;
      line-height: 1.6;
      color: $home-text;
    }

    &__more {
      margin-top: auto;
      padding-top: 4px;
      font-size: 15px;
      font-weight: 500;
      color: $color-primary;
      word-spacing: 0.14em;
    }

    // ---------- duża karta ----------
    &--featured &__link {
      @include respond-to("md") {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
      }
    }

    &--featured &__media {
      aspect-ratio: 4 / 3;

      @include respond-to("md") {
        aspect-ratio: auto;
        min-height: 400px;
      }
    }

    &--featured &__body {
      justify-content: center;
      gap: 14px;
      padding: 28px 24px;

      @include respond-to("md") {
        padding: 40px;
        gap: 16px;
      }
    }

    &--featured &__title {
      font-size: 24px;
      line-height: 1.2;

      @include respond-to("lg") {
        font-size: 32px;
      }
    }

    &--featured &__desc {
      font-size: 17px;
    }

    &--featured &__more {
      margin-top: 0;
    }
  }
</style>
