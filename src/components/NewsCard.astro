---
// src/components/NewsCard.astro
// Karta newsa w dwóch wariantach:
// - "featured": duża, pozioma karta dla najnowszego wpisu
// - "compact":  mniejsza karta do siatki pod spodem
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ForwardButton from "./ForwardButton.astro";

interface Props {
  entry: CollectionEntry<"blog">;
  variant?: "featured" | "compact";
}

const { entry, variant = "compact" } = Astro.props;
const { title, description, date, image, tags } = entry.data;

const href = `/blog/${entry.id}`;
const isFeatured = variant === "featured";
const tag = tags?.[0];

const formattedDate = date
  ? date.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" })
  : null;

---

<article class:list={["news-card", `news-card--${variant}`]}>
  <a href={href} class="news-card__link" data-forward-hover>
    <div class="news-card__media">
      {
        image?.url ? (
          <Image
            src={image.url}
            alt=""
            class="news-card__image"
            widths={isFeatured ? [640, 960, 1400] : [400, 600, 900]}
            sizes={isFeatured ? "(min-width: 768px) 60vw, 100vw" : "(min-width: 768px) 33vw, 100vw"}
            loading={isFeatured ? "eager" : "lazy"}
          />
        ) : (
          // Brak zdjęcia – estetyczny zamiennik zamiast szarego placeholdera
          <div class="news-card__fallback" aria-hidden="true">
            <span class="news-card__fallback-icon">◆</span>
            <span class="news-card__fallback-text">Newsy</span>
          </div>
        )
      }
      {isFeatured && <span class="news-card__badge">Najnowsze</span>}
    </div>

    <div class="news-card__body">
      {
        (tag || formattedDate) && (
          <p class="news-card__meta">
            {tag && <span class="news-card__tag">{tag}</span>}
            {formattedDate && <time datetime={date?.toISOString()}>{formattedDate}</time>}
          </p>
        )
      }

      <h3 class="news-card__title">{title}</h3>

      {description && <p class="news-card__description">{description}</p>}

      <div class="news-card__more">
        <ForwardButton />
      </div>
    </div>
  </a>
</article>

<style lang="scss">
  @use "sass:color";
  @use "../styles/variables" as *;
  @use "../styles/mixins" as *;

  $border: color.mix($color-text, $color-bg, 20%);

  .news-card {
    height: 100%;

    &__link {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: inherit;
      text-decoration: none;
      background: $color-bg;
      border: 1px dashed $border;
      border-radius: 1.5rem;
      overflow: hidden;
      transition:
        transform $transition-base,
        box-shadow $transition-base,
        border-color $transition-base;

      &:hover {
        transform: translateY(-4px);
        border-color: color.mix($color-text, $color-bg, 45%);
        box-shadow: 0 18px 40px -24px rgba(15, 23, 42, 0.35);
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 4px;
      }
    }

    // ---------- Zdjęcie ----------
    &__media {
      position: relative;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      background: color.mix($color-text, $color-bg, 6%);
    }

    &__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms ease;
    }

    &__link:hover &__image {
      transform: scale(1.04);
    }

    &__fallback {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      height: 100%;
      color: color.mix($color-primary, $color-bg, 35%);
      background:
        radial-gradient($bg-pattern-dot 1px, transparent 1px) 0 0 / 14px 14px,
        linear-gradient(135deg, color.mix($color-accent, $color-bg, 8%), color.mix($color-text, $color-bg, 6%));
    }

    &__fallback-icon {
      font-size: 2rem;
      color: $color-accent;
      opacity: 0.6;
    }

    &__fallback-text {
      font-family: $font-family-heading;
      font-size: 0.85rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    &__badge {
      position: absolute;
      top: 1rem;
      left: 1rem;
      padding: 0.35rem 0.75rem;
      font-family: $font-family-heading;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: $color-bg;
      background: $color-primary;
      border-radius: 999px;
    }

    // ---------- Treść ----------
    &__body {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 0.75rem;
      padding: 1.25rem 1.5rem 1.5rem;
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin: 0;
      font-size: 0.85rem;
      color: color.mix($color-text, $color-bg, 75%);
    }

    &__tag {
      padding: 0.2rem 0.6rem;
      font-family: $font-family-heading;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: $color-accent;
      background: color.mix($color-accent, $color-bg, 10%);
      border-radius: 999px;
    }

    &__title {
      margin: 0;
      font-size: 1.2rem;
      line-height: 1.3;
      text-transform: none;
      color: $color-primary;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    &__description {
      margin: 0;
      font-size: 0.975rem;
      line-height: 1.55;
      color: color.mix($color-text, $color-bg, 85%);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    &__more {
      margin-top: auto;
    }

    // ---------- Wariant: duża karta ----------
    &--featured {
      .news-card__link {
        @include respond-to("md") {
          display: grid;
          grid-template-columns: 1.35fr 1fr;
        }
      }

      .news-card__media {
        aspect-ratio: 16 / 10;

        @include respond-to("md") {
          aspect-ratio: auto;
          min-height: 22rem;
        }
      }

      .news-card__body {
        justify-content: center;
        gap: 1rem;
        padding: 1.5rem;

        @include respond-to("md") {
          padding: 2.5rem;
        }
      }

      .news-card__title {
        font-size: 1.6rem;
        -webkit-line-clamp: 3;

        @include respond-to("lg") {
          font-size: 2.25rem;
        }
      }

      .news-card__description {
        font-size: 1.05rem;
        -webkit-line-clamp: 4;

        @include respond-to("lg") {
          font-size: 1.15rem;
        }
      }

      .news-card__more {
        margin-top: 0.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      &__link,
      &__image {
        transition: none;
      }

      &__link:hover {
        transform: none;
      }
    }
  }
</style>
