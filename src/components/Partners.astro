---
// src/components/Partners.astro
import { Image } from "astro:assets";

export interface Partner {
  name: string;
  logo: ImageMetadata;
  url?: string | null;
  alt?: string;
}

interface Props {
  title?: string;
  partners: Partner[];
  class?: string;
}

const { title = "🤝 Partnerzy i Sponsorzy", partners = [], class: className = "" } = Astro.props;
---

{
  partners && partners.length > 0 && (
    <section class:list={["partners", className]} aria-labelledby="partners-heading">
      <div class="partners__container">
        {title && <h2 id="partners-heading" class="partners__title">{title}</h2>}

        <div class="partners__grid">
          {partners.map((partner) => {
            const imageAlt = partner.alt || `Logo partnera ${partner.name}`;

            return partner.url ? (
              <a
                href={partner.url}
                target="_blank"
                rel="noopener noreferrer"
                class="partners__link"
                aria-label={`Odwiedź stronę partnera ${partner.name}`}
              >
                <Image
                  src={partner.logo}
                  alt={imageAlt}
                  class="partners__logo"
                  loading="lazy"
                />
              </a>
            ) : (
              <div class="partners__item">
                <Image
                  src={partner.logo}
                  alt={imageAlt}
                  class="partners__logo"
                  loading="lazy"
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}

