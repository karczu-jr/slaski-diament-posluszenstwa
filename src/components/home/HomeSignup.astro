---
// src/components/home/HomeSignup.astro
// "Poznaj termin kolejnych zawodów" – biała karta na szarym tle z polem e-mail.
// Adres formularza Brevo ustawiamy w src/data/home.ts (SIGNUP.action).
// Wysyłka idzie w tle (bez przechodzenia na stronę Brevo), komunikat pokazuje się pod polem.
import { SIGNUP } from "../../data/home";

interface Props {
  /** "grey" – szare tło i biała karta (domyślnie); "white" – odwrotnie, gdy sekcja wyżej jest szara */
  tone?: "grey" | "white";
}
const { tone = "grey" } = Astro.props;
const connected = SIGNUP.action !== "";
---

<section class:list={["signup", `signup--${tone}`]} id="powiadom" aria-labelledby="signup-title">
  <div class="signup__wrap">
    <div class="signup__card">
      <h2 id="signup-title" class="signup__title">Poznaj termin kolejnych zawodów <span aria-hidden="true">🔔</span></h2>

      <form
        class="signup__form"
        method="post"
        action={connected ? SIGNUP.action : undefined}
        data-signup={connected ? "brevo" : "offline"}
      >
        <label for="signup-email" class="signup__label">Adres e-mail</label>
        <div class="signup__row">
          <input
            id="signup-email"
            name="EMAIL"
            type="email"
            required
            autocomplete="email"
            placeholder="ty@przyklad.pl"
            class="signup__input"
          />
          <button type="submit" class="signup__btn"><span class="nudge" aria-hidden="true">👉</span> Zapisuję się</button>
        </div>
        <!-- Pułapka na boty: ludzie tego pola nie widzą, boty je wypełniają, a Brevo odrzuca takie zgłoszenia -->
        <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="signup__trap" />
        <input type="hidden" name="locale" value="pl" />
        <p class="signup__note">
          Napiszemy, gdy ogłosimy termin kolejnych zawodów. Wypiszesz się jednym kliknięciem.{" "}
          <a href={SIGNUP.privacyUrl}>Polityka prywatności</a>
        </p>
        <p class="signup__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Komunikaty – te same teksty co w ustawieniach formularza w Brevo
  const MSG = {
    sending: "Wysyłam…",
    success: "Dzięki! Sprawdź skrzynkę i potwierdź zapis 📬",
    error: "Coś poszło nie tak. Spróbuj ponownie za chwilę.",
    offline: "Powiadomienia uruchomimy wkrótce. Dziękujemy za cierpliwość!",
  };
  // Człowiek nie wpisze adresu szybciej – szybsze zgłoszenia traktujemy jak bota
  const MIN_MS = 2000;
  const openedAt = Date.now();

  document.querySelectorAll<HTMLFormElement>("form[data-signup]").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".signup__status");
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const say = (text: string, isError = false) => {
      if (!status) return;
      status.textContent = text;
      status.classList.toggle("signup__status--error", isError);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form.dataset.signup === "offline") return say(MSG.offline);
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      // Bot (pułapka wypełniona albo zbyt szybko) – udajemy sukces, nic nie wysyłamy
      if (data.get("email_address_check") || Date.now() - openedAt < MIN_MS) {
        form.reset();
        return say(MSG.success);
      }

      btn?.setAttribute("disabled", "");
      say(MSG.sending);
      try {
        const res = await fetch(`${form.action}?isAjax=1`, { method: "POST", body: data });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error("brevo");
        form.reset();
        say(MSG.success);
      } catch {
        say(MSG.error, true);
      } finally {
        btn?.removeAttribute("disabled");
      }
    });
  });
</script>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;
  @use "../../styles/home" as *;

  .signup {
    background: $home-grey;
    scroll-margin-top: 80px;

    // Wariant odwrócony: białe tło, szara karta, białe pole e-mail
    &--white {
      background: #ffffff;
    }

    &--white &__card {
      background: $home-grey;
    }

    &--white &__input {
      background: #ffffff;
    }

    &__wrap {
      @include home-wrap;
    }

    &__card {
      display: grid;
      gap: 28px 64px;
      align-items: center;
      padding: 32px 24px;
      border-radius: 28px;
      background: #ffffff;

      @include respond-to("md") {
        padding: 56px;
      }

      @include respond-to("lg") {
        grid-template-columns: 1fr 1fr;
        padding: 72px;
      }
    }

    &__title {
      @include home-h2;
      font-weight: 600;
      font-size: 34px;

      @include respond-to("md") {
        font-size: 52px;
      }
    }

    &__form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    &__label {
      font-size: 17px;
      font-weight: 500;
      color: $color-primary;
    }

    &__row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    &__input {
      flex: 1 1 220px;
      min-width: 0;
      font: inherit;
      font-size: 17px;
      padding: 15px 24px;
      border-radius: 999px;
      border: 1px solid #dcdcda;
      background: #f1f1ef;
      color: $color-primary;
    }

    &__btn {
      @include home-button-dark;
      font-size: 17px;
      padding: 15px 28px;
    }

    &__note {
      margin: 4px 0 0;
      font-size: 13px;
      line-height: 1.5;
      color: $home-muted;

      a {
        color: $color-primary;
      }
    }

    &__btn[disabled] {
      opacity: 0.6;
      cursor: wait;
    }

    // Pole-pułapka na boty: poza ekranem (nie display:none – część botów to sprawdza)
    &__trap {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    &__status {
      margin: 0;
      font-size: 15px;
      font-weight: 500;
      color: $color-accent;

      &:empty {
        display: none;
      }

      &--error {
        color: #b91c1c;
      }
    }
  }
</style>
