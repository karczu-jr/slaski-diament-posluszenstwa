---
// src/components/Footer.astro
// Stopka (wersja 5): logo + hasło, trzy kolumny linków, pasek z prawami autorskimi.
// Granatowe tło – kolor marki. Edycje w kolumnie "Zawody" biorą się z plików .mdx.
import { ANALYTICS, SITE, SOCIALS } from "../consts";
import Logo from "./Logo.astro";
import { getEditions } from "../data/editions";

const { past } = await getEditions();
const editions = past.slice(0, 3);
const galleryEdition = past.find((e) => e.data.gallery?.length);
const currentYear = new Date().getFullYear();
---

<footer class="footer" id="kontakt">
  <div class="footer__container">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label={`${SITE.TITLE} – strona główna`}>
        <Logo variant="compact" size="1rem" inverted />
      </a>
      <p class="footer__motto">Z miłości do Obedience ♥️</p>
    </div>

    <nav class="footer__column" aria-labelledby="footer-zawody">
      <h2 id="footer-zawody" class="footer__heading">Zawody</h2>
      <ul class="footer__list">
        {
          editions.map((e) => (
            <li>
              <a href={`/projects/${e.id}`} class="footer__link">{e.data.title}</a>
            </li>
          ))
        }
        <li><a href="/projects" class="footer__link">Wszystkie edycje</a></li>
      </ul>
    </nav>

    <nav class="footer__column" aria-labelledby="footer-biezaco">
      <h2 id="footer-biezaco" class="footer__heading">Na bieżąco</h2>
      <ul class="footer__list">
        <li><a href="/blog" class="footer__link">Newsy</a></li>
        {
          galleryEdition && (
            <li>
              <a href={`/projects/${galleryEdition.id}`} class="footer__link">Galeria</a>
            </li>
          )
        }
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.HREF} class="footer__link" target="_blank" rel="noopener noreferrer">
                {s.NAME}
                <span class="sr-only"> (otwiera się w nowej karcie)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__column" aria-labelledby="footer-onas">
      <h2 id="footer-onas" class="footer__heading">O nas</h2>
      <ul class="footer__list">
        <li><a href="/about" class="footer__link">Organizatorzy</a></li>
        <li><a href="/contact" class="footer__link">Kontakt</a></li>
        <li>
          <a href={`mailto:${SITE.EMAIL}`} class="footer__link">
            {/* długi adres łamie się po "@", a nie w połowie słowa */}
            {SITE.EMAIL.split("@")[0]}@<wbr />{SITE.EMAIL.split("@")[1]}
          </a>
        </li>
      </ul>
    </nav>

    <div class="footer__bottom">
      <p class="footer__copyright">© {currentYear} {SITE.TITLE}. Zdjęcia: Marta Wlazło.</p>
      <ul class="footer__legal" role="list">
        <li><a href="/polityka-prywatnosci" class="footer__legal-link">Polityka prywatności</a></li>
        {
          ANALYTICS.GA_ID && (
            <li>
              {/* id wymagane przez baner TermsFeed – otwiera ustawienia cookies */}
              <a href="#" id="open_preferences_center" class="footer__legal-link">Ustawienia cookies</a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</footer>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/mixins" as *;
  @use "../styles/home" as *;

  .footer {
    background: $color-primary;
    color: #c3cad8;
    font-size: 15px;
    line-height: 1.6;

    &__container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 56px 24px 32px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 32px;

      @include respond-to("md") {
        padding: 64px 24px 32px;
      }

      @include respond-to("lg") {
        grid-template-columns: 1.4fr repeat(3, 1fr);
      }
    }

    &__brand {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      gap: 16px;

      @include respond-to("lg") {
        grid-column: auto;
      }
    }

    &__logo {
      display: inline-flex;
      align-self: flex-start;
      text-decoration: none;

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 4px;
        border-radius: 4px;
      }
    }

    &__motto {
      margin: 0;
      color: #aab4c8;
    }

    &__heading {
      @include heading-reset;
      margin-bottom: 12px;
      font-family: $font-family-body;
      font-size: 13px;
      font-weight: 600;
      color: #ffffff;
    }

    &__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    &__link {
      display: inline-block;
      min-height: 24px;
      color: #c3cad8;
      text-decoration: none;
      overflow-wrap: break-word;
      transition: color $transition-base;

      &:hover {
        color: #ffffff;
        text-decoration: underline;
      }

      &:focus-visible {
        outline: 3px solid $color-accent;
        outline-offset: 3px;
        border-radius: 4px;
      }
    }

    &__bottom {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px 24px;
      margin-top: 16px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 13px;
      color: #8a93a6;
    }

    &__copyright {
      margin: 0;
    }

    &__legal {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px 20px;
    }

    &__legal-link {
      color: #8a93a6;
      text-decoration: underline;
      text-underline-offset: 0.2em;

      &:hover {
        color: #ffffff;
      }
    }
  }
</style>
