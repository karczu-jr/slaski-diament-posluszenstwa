---
// src/components/AnnouncementBar.astro
// Pasek ogłoszeń na samej górze strony (nad menu). Treść i włącznik: src/data/announcement.ts.
// Pasek przewija się razem ze stroną; skrypt w Layout przesuwa przyklejone menu tuż pod niego.
import { ANNOUNCEMENT } from "../data/announcement";
const external = /^https?:\/\//.test(ANNOUNCEMENT.href);
---

{
  ANNOUNCEMENT.enabled && (
    <aside class="announce" aria-label="Ogłoszenie" data-announce>
      <p class="announce__inner">
        <span class="announce__text">{ANNOUNCEMENT.text}</span>
        <a
          href={ANNOUNCEMENT.href}
          class="announce__btn"
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {ANNOUNCEMENT.linkText}
          {external && <span class="sr-only"> (otwiera się w nowej karcie)</span>}
        </a>
      </p>
    </aside>
  )
}

<style lang="scss">
  @use "../styles/variables" as *;

  .announce {
    position: relative;
    z-index: 60; // nad menu strony głównej, które leży na hero
    background: $color-primary;
    color: #ffffff;
  }

  .announce__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 8px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 16px;
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
  }

  .announce__text {
    font-weight: 500;
  }

  .announce__btn {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 6px 16px;
    border-radius: 999px;
    background: #ffffff;
    color: $color-primary;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    word-spacing: 0.14em;
    transition: background $transition-base;

    &:hover {
      background: #e9effd;
      color: $color-primary;
    }

    &:focus-visible {
      outline: 3px solid $color-accent;
      outline-offset: 2px;
    }
  }
</style>
