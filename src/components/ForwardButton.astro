---
// src/components/ForwardButton.astro
// Odpowiednik BackButton do przechodzenia dalej ("Czytaj dalej 👉").
// - z `href`  → samodzielny link
// - bez `href` → sam napis, np. wewnątrz karty, która w całości jest linkiem
//   (link w linku jest niedozwolony). Rodzic z atrybutem `data-forward-hover`
//   podświetla napis po najechaniu na całą kartę.
interface Props {
  href?: string;
  text?: string;
  icon?: string;
  target?: string;
  class?: string;
}

const { href, text = "Czytaj dalej", icon = "👉", target, class: className = "" } = Astro.props;
const Element = href ? "a" : "span";
---

<Element
  href={href}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  class:list={["forward-button", { "forward-button--static": !href }, className]}
  aria-hidden={href ? undefined : "true"}
>
  <span class="forward-button__text">{text}</span>
  <span class="forward-button__icon" aria-hidden="true">{icon}</span>
</Element>

<style lang="scss">
  @use "../styles/variables" as *;

  // Wygląd 1:1 z BackButton – ten sam rozmiar, grubość i podkreślenie
  .forward-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px; // Minimalny obszar dotykowy (WCAG 2.2)
    padding: 0.5rem 0;
    color: $color-primary;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: color $transition-base;

    &__text {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    &__icon {
      display: inline-block;
      font-size: 1.25em;
      line-height: 1;
      transition: transform $transition-base;
    }

    &:hover,
    :global([data-forward-hover]:hover) & {
      color: $color-accent;

      .forward-button__icon {
        transform: translateX(4px);
      }
    }

    &:focus-visible {
      outline: 3px solid $color-accent;
      outline-offset: 2px;
      border-radius: 0.25rem;
    }

    @media (prefers-reduced-motion: reduce) {
      &__icon {
        transition: none;
      }

      &:hover .forward-button__icon,
      :global([data-forward-hover]:hover) & .forward-button__icon {
        transform: none;
      }
    }
  }
</style>
