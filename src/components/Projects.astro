---
// src/components/Projects.astro
import Card from "./Card.astro";
import Marquee from "./Marquee.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const allProjects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
).sort(
    (a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0)
).slice(0, 3);
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <!-- Pasek animowanego napisu (Marquee) -->
  <Marquee text="Zawody" />

  <!-- Dostępny nagłówek dla czytników ekranowych -->
  <h2 id="projects-title" class="sr-only">Nadchodzące i ostatnie zawody</h2>

  <!-- Lista projektów/zawodów -->
  <div class="projects__list">
    {allProjects.map((project) => <Card entry={project} />)}
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .projects {
    padding-top: 4.5rem;
    padding-bottom: 2rem;

    // Lista kart z projektami
    &__list {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
  }

  // Animacja ciągłego przewijania
  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>