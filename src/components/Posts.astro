---
// src/components/Posts.astro
import Card from "./Card.astro";
import Marquee from "./Marquee.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const allPosts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).valueOf() : 0;
    const dateB = b.data.date ? new Date(b.data.date).valueOf() : 0;
    return dateB - dateA;
  })
  .slice(0, 3);
---

<section id="posts" class="posts" aria-labelledby="posts-title">
  <!-- Pasek animowanego napisu (Marquee) -->
  <Marquee text="Newsy" />

  <!-- Dostępny nagłówek dla czytników ekranowych -->
  <h2 id="posts-title" class="sr-only">Aktualne Newsy</h2>

  <!-- Lista artykułów blogowych -->
  <div class="posts__list">
    {allPosts.map((post) => <Card entry={post} />)}
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;
  @use '../styles/typography' as *;

  .posts {
    padding-top: 4.5rem;
    padding-bottom: 2rem;
    
    // Grid / Lista wpisów
    &__list {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
  }

  // Animacja ciągłego przewijania
  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>