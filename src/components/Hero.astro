---
// src/components/Hero.astro
import Logo from "./Logo.astro";
import ButtonPrimary from "./ButtonPrimary.astro";
import ButtonSecondary from "./ButtonSecondary.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__container">
    <h1 id="hero-title" class="hero__title">
      <Logo variant="compact" size="clamp(1.5rem, 7.8vw, 3.25rem)" />
    </h1>
    
    <div class="hero__content">
      <p class="hero__description">
        Śląski Diament Posłuszeństwa to wyjątkowe wydarzenie na mapie polskich sportów kynologicznych, łączące pasję do Obedience z profesjonalną organizacją i wyjątkową, rodzinną atmosferą.
      </p>
      
      <div class="hero__actions">
        <ButtonPrimary 
          text="Najbliższe zawody" 
          href="/projects" 
          class="hero__btn" 
        />
        <ButtonSecondary 
          text="Zapytaj nas" 
          href="#contact" 
          class="hero__btn" 
        />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;
  @use '../styles/typography' as *;

  .hero {
    width: 100%;
    min-height: calc(100vh - 5rem);
    display: flex;
    align-items: center;
    padding-top: 4.5rem;
    padding-bottom: 2rem;

    &__container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      align-items: center;
      gap: 2rem;

      @include respond-to('md') {
        gap: 4rem;
      }

      @include respond-to('lg') {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    // Tytuł strony = logotyp (rozmiar ustawia komponent Logo)
    &__title {
      margin: 0;
      line-height: 1;
    }

    &__content {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    &__actions {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;

      @include respond-to('sm') {
        flex-direction: row;
      }
    }

    // Klasa układowa przekazywana do komponentu przycisku
    :global(.hero__btn) {
      width: 100%;

      @include respond-to('sm') {
        width: auto;
        padding-left: 2.5rem;
        padding-right: 2.5rem;
      }
    }
  }
</style>