---
// src/layouts/Layout.astro
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { SITE } from "../consts";

import "../styles/main.scss";

type Props = {
  title: string;
  description: string;
  image?: string;
};

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <Head title={`${title} | ${SITE.TITLE}`} description={description} image={image} />
  <body>
    <!-- Skocz do treści (A11y) -->
    <a href="#main-content" class="skip-link">
      Przejdź do głównej treści
    </a>

    <!-- Pasek ogłoszeń (włącznik: src/data/announcement.ts) -->
    <AnnouncementBar />

    <Header />
    
    <div class="layout-wrapper">
      <div class="layout-wrapper__background" aria-hidden="true"></div>
      <main id="main-content" class="layout-wrapper__main">
        <slot />
      </main>
    </div>

    <Footer />
    <CookieConsent />
    <script>
      // Pasek ogłoszeń przewija się ze stroną – menu (przyklejone) startuje tuż pod nim,
      // a gdy pasek zniknie u góry ekranu, menu dojeżdża do samej krawędzi.
      const bar = document.querySelector<HTMLElement>("[data-announce]");
      if (bar) {
        const root = document.documentElement;
        const update = () => {
          const h = bar.offsetHeight;
          root.style.setProperty("--announce-h", `${h}px`);
          root.style.setProperty("--header-top", `${Math.max(0, h - window.scrollY)}px`);
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
      }
    </script>
    <script>
      // Treść pojawia się przy przewijaniu: bloki każdej sekcji (nagłówek, tekst, karty)
      // wjeżdżają od dołu, a elementy list – kolejno, jeden po drugim.
      // To, co widać od razu po wejściu na stronę, nie jest animowane.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const main = document.getElementById("main-content");
      if (!reduce && main && "IntersectionObserver" in window) {
        const targets: HTMLElement[] = [];
        const add = (el: Element, delay = 0) => {
          const h = el as HTMLElement;
          if (getComputedStyle(h).display === "contents") {
            [...h.children].forEach((c, i) => add(c, i));
            return;
          }
          if (h.getBoundingClientRect().top < window.innerHeight * 0.9) return;
          if (delay) h.style.setProperty("--reveal-delay", `${Math.min(delay, 5) * 80}ms`);
          h.dataset.reveal = "";
          targets.push(h);
        };

        main.querySelectorAll("section, nav:not([data-subnav])").forEach((group) => {
          if (group.parentElement?.closest("section")) return; // tylko sekcje najwyższego poziomu
          let box: Element = group;
          while (box.children.length === 1 && box.firstElementChild?.tagName === "DIV") box = box.firstElementChild;
          [...box.children].forEach((el) => {
            if (el.matches("ul, ol") && el.children.length > 1) [...el.children].forEach((li, i) => add(li, i));
            else add(el);
          });
        });

        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }),
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 }
        );
        // Po wjeździe oddajemy elementowi jego własne przejścia (np. uniesienie karty po najechaniu)
        const done = (e: TransitionEvent) => {
          const el = e.currentTarget as HTMLElement;
          // tylko koniec wjazdu (samo ukrycie na starcie też kończy się zdarzeniem transitionend)
          if (e.target !== el || e.propertyName !== "opacity" || !el.classList.contains("is-visible")) return;
          delete el.dataset.reveal;
          el.classList.remove("is-visible");
          el.style.removeProperty("--reveal-delay");
          el.removeEventListener("transitionend", done);
        };
        targets.forEach((t) => {
          t.addEventListener("transitionend", done);
          io.observe(t);
        });
        document.documentElement.classList.add("reveal-ready");
      }
    </script>
  </body>
</html>

<style lang="scss">
  @use '../styles/variables' as *;

  // Przycisk ułatwienia dostępu (Skip Link)
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 9999;
    padding: 0.75rem 1.25rem;
    background-color: $color-accent;
    color: #ffffff;
    font-weight: 600;
    border-radius: 0.375rem;
    text-decoration: none;
    transition: top 200ms ease-in-out;

    &:focus-visible {
      top: 1rem;
    }
  }

  .layout-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;

    &__background {
      position: fixed;
      inset: 0;
      z-index: -50;
      background-color: $color-bg;
      background-image: radial-gradient(
        circle at 1px 1px,
        $bg-pattern-dot 1px,
        transparent 0
      );
      background-size: 25px 25px;
      pointer-events: none;
    }

    &__main {
      flex: 1;
      width: 100%;
    }
  }
</style>