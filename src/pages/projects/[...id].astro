---
// src/pages/projects/[...id].astro - WERSJA 1: Układ pionowy (Image -> Content -> Gallery)
import ProseImage from "../../components/ProseImage.astro";
import Layout from "../../layouts/Layout.astro";
import BackButton from "../../components/BackButton.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";
import PartnersMarquee from "@/components/PartnersMarquee.astro";
import Gallery from "@/components/Gallery.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const allProjects: CollectionEntry<"projects">[] = await getCollection("projects");

  return allProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const imageUrl = project.data.image?.url;
const imageAlt = project.data.image?.alt || project.data.title;
---

<Layout title={project.data.title} description={project.data.description}>
  <div class="project-details">
    <div class="project-details__back-wrapper">
      <BackButton fallbackHref="/projects" />
    </div>

    <header class="project-details__header">
      <div class="project-details__header-info">
        <!-- <h1 class="project-details__title">
          {project.data.title}
        </h1> -->
        <h1>
          Śląski Diament Posłuszeństwa<br><span>{project.data.title}</span>
        </h1>
        <p class="project-details__description">{project.data.description}</p>
      </div>

      <div class="project-details__actions">
        {
          project.data.formUrl && (
            <ButtonPrimary
              href={project.data.formUrl}
              icon="📝"
              text="Zapisz się"
              target="_blank"
            />
          )
        }
        {
          project.data.facebookUrl && (
            <ButtonSecondary
              href={project.data.facebookUrl}
              icon="🌐"
              text="Facebook"
              target="_blank"
            />
          )
        }
      </div>
    </header>

    <div class="project-details__body">
      {
        imageUrl && (
          <div class="project-details__main-image-wrapper">
            <Image
              src={imageUrl}
              alt={imageAlt}
              inferSize={true}
              class="project-details__main-image"
              loading="eager"
            />
          </div>
        )
      }

      <article class="project-details__content">
        <Content components={{ img: ProseImage }} />
      </article>
      {project.data.partners && <PartnersMarquee partners={project.data.partners} />}
    </div>

    

    {
      project.data.gallery && project.data.gallery.length > 0 && (
        <div class="project-details__gallery">
          <Gallery
            images={project.data.gallery}
            fallbackAlt={`Zdjęcie z zawodów – ${project.data.title}`}
          />
        </div>
      )
    }
  </div>
</Layout>

<style lang="scss">
  @use "sass:color";
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;
  @use "../../styles/prose" as *;

  .project-details {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem;

    &__back-wrapper {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }

    &__header {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px dashed color.mix($color-text, $color-bg, 30%);

      @include respond-to('md') {
        flex-direction: row;
        align-items: center;
      }
    }

    &__header-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 52rem;
    }

    &__title {
      font-size: 1.875rem;
      font-weight: 500;
      text-transform: uppercase;
      line-height: 1.2;
      color: $color-primary;

      @include respond-to('md') {
        font-size: 3rem;
      }

      span {
        font-size: 1.25rem;

        @include respond-to('md') {
          font-size: 1.75rem;
        }
      }
    }

    &__description {
      font-size: 1.5rem;
      line-height: 1.6;
      color: $color-text;
    }

    &__actions {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;

      @include respond-to('sm') {
        flex-direction: row;
        width: auto;
      }
    }

    :global(.project-details__btn) {
      width: 100%;

      @include respond-to('sm') {
        width: auto;
      }
    }

    // Układ pionowy dla sekcji głównej
    &__body {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      margin-top: 2.5rem;
    }

    &__main-image-wrapper {
      width: 100%;
      aspect-ratio: 610 / 400;
      overflow: hidden;
      border-radius: 1rem;

      @include respond-to('md') {
        aspect-ratio: 21 / 9;
      }
    }

    &__main-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__content {
      max-width: 52rem;
      width: 100%;
      margin: auto;
      font-size: 1.125rem;
      line-height: 1.7;
      color: $color-text;

      @include prose;
    } // <- TUTAJ BRAKOWAŁO NAWIASU ZAMYKAJĄCEGO &__content

    // Sekcja galerii na pełną szerokość pod treścią
    &__gallery {
      margin-top: 3rem;
      margin-bottom: 4.5rem;
      padding-top: 3rem;
      border-top: 1px dashed color.mix($color-text, $color-bg, 30%);
    }
  }
</style>