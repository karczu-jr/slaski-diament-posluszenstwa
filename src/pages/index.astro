---
// src/pages/index.astro
// Strona główna (wersja 5): hero z rolką → newsy → edycje → kim jesteśmy → galeria → zapisy.
// Newsy, edycje i galeria pochodzą z plików .mdx w src/content/.
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeNews from "../components/home/HomeNews.astro";
import HomeEditions from "../components/home/HomeEditions.astro";
import HomeAbout from "../components/home/HomeAbout.astro";
import HomeGallery from "../components/home/HomeGallery.astro";
import HomeSignup from "../components/home/HomeSignup.astro";

import { SITE } from "../consts";
---

<Layout title="Zawody Obedience" description={SITE.DESCRIPTION}>
  <div class="home">
    <HomeHero />
    <HomeNews />
    <HomeEditions />
    <HomeAbout />
    <HomeGallery />
    <HomeSignup />
  </div>
</Layout>

<style lang="scss">
  // Strona główna ma własną, spokojniejszą skalę tekstu (17 px) i jednolite białe tło
  .home {
    background: #ffffff;
    font-size: 17px;
    line-height: 1.6;
  }
</style>
