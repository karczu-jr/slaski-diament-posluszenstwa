---
// src/pages/contact.astro
// Strona "Kontakt" (wersja 5): nagłówek, formularz w białej karcie i adres e-mail obok.
// Formularz: dopóki CONTACT_FORM.action jest pusty, przycisk otwiera program pocztowy
// z gotową wiadomością do SITE.EMAIL. Po podpięciu usługi (np. Formspree) wpisz jej adres.
import Layout from "../layouts/Layout.astro";
import { CONTACT, SITE, SOCIALS } from "../consts";

const CONTACT_FORM = { action: "" };

// Telefony do organizatorów – TODO: na razie przykładowe numery, podmień na prawdziwe.
const PHONES = [
  { name: "Magda", phone: "+48 123 456 789" },
  { name: "Mateusz", phone: "+48 987 654 321" },
];
const tel = (p: string) => `tel:${p.replace(/\s/g, "")}`;

const TOPICS = [
  "📝 Zapisy, klasy i opłata startowa",
  "📋 Regulamin i przebieg zawodów",
  "📍 Dojazd i miejsce zawodów",
  "🤝 Współpraca i partnerstwo",
];
---

<Layout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <div class="contact-page">
    <header class="contact-page__header">
      <p class="contact-page__eyebrow">✉️ Kontakt</p>
      <h1 class="contact-page__title">Napisz do nas</h1>
      <p class="contact-page__lead">
        Masz pytanie o zawody, swój start albo chcesz zostać partnerem? Napisz – chętnie pomożemy.
      </p>
    </header>

    <section class="contact-page__main" aria-label="Formularz i dane kontaktowe">
      <div class="contact-page__wrap">
        <form
          class="contact-page__form"
          action={CONTACT_FORM.action || `mailto:${SITE.EMAIL}`}
          method="POST"
          data-contact-form
          data-mailto={CONTACT_FORM.action ? undefined : SITE.EMAIL}
        >
          <h2 class="contact-page__form-title">Formularz kontaktowy</h2>

          <div class="contact-page__row">
            <div class="contact-page__field">
              <label for="contact-name" class="contact-page__label">Imię i nazwisko</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required class="contact-page__input" />
            </div>
            <div class="contact-page__field">
              <label for="contact-email" class="contact-page__label">Adres e-mail</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="contact-page__input"
              />
            </div>
          </div>

          <div class="contact-page__field">
            <label for="contact-message" class="contact-page__label">Wiadomość</label>
            <textarea id="contact-message" name="message" rows="6" required class="contact-page__input contact-page__textarea"
            ></textarea>
          </div>

          <div class="contact-page__actions">
            <button type="submit" class="contact-page__submit">
              Wyślij wiadomość <span class="nudge" aria-hidden="true">👉</span>
            </button>
            <p class="contact-page__hint">Wszystkie pola są wymagane.</p>
          </div>
        </form>

        <aside class="contact-page__info">
          <div class="contact-page__card contact-page__card--dark">
            <p class="contact-page__card-label">Wolisz e-mail?</p>
            <a href={`mailto:${SITE.EMAIL}`} class="contact-page__mail">{SITE.EMAIL}</a>
          </div>

          <div class="contact-page__card">
            <h2 class="contact-page__card-title">Zadzwoń 📞</h2>
            <ul class="contact-page__phones" role="list">
              {
                PHONES.map((p) => (
                  <li class="contact-page__phone-item">
                    <strong class="contact-page__phone-who">{p.name}</strong>
                    <a href={tel(p.phone)} class="contact-page__phone">{p.phone}</a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="contact-page__card">
            <h2 class="contact-page__card-title">O co możesz zapytać</h2>
            <ul class="contact-page__topics" role="list">
              {TOPICS.map((t) => <li>{t}</li>)}
            </ul>
          </div>

          {
            SOCIALS.length > 0 && (
              <div class="contact-page__card">
                <h2 class="contact-page__card-title">Śledź nas</h2>
                <ul class="contact-page__socials" role="list">
                  {SOCIALS.map((s) => (
                    <li>
                      <a href={s.HREF} target="_blank" rel="noopener noreferrer" class="contact-page__social">
                        {s.NAME}
                        <span class="sr-only"> (otwiera się w nowej karcie)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Bez usługi do wysyłki: składamy wiadomość i otwieramy program pocztowy.
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const to = form?.dataset.mailto;
  if (form && to) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const subject = `Pytanie ze strony – ${data.get("name")}`;
      const body = `${data.get("message")}\n\n${data.get("name")}\n${data.get("email")}`;
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>

<style lang="scss">
  @use "../styles/variables" as *;
  @use "../styles/mixins" as *;
  @use "../styles/home" as *;

  .contact-page {
    background: #ffffff;
    font-size: 17px;
    line-height: 1.6;
    color: $home-text;

    &__header {
      max-width: 1280px;
      margin: 0 auto;
      padding: 120px 24px 48px;

      @include respond-to("md") {
        padding: 144px 24px 56px;
      }
    }

    &__eyebrow {
      @include home-eyebrow;
    }

    &__title {
      @include home-h2;
      font-weight: 600;
      font-size: 36px;

      @include respond-to("md") {
        font-size: 52px;
      }
    }

    &__lead {
      margin: 16px 0 0;
      max-width: 640px;
      font-size: 18px;
      line-height: 1.55;
      color: #3f3f46;

      @include respond-to("md") {
        font-size: 20px;
      }
    }

    &__main {
      background: $home-grey;
    }

    &__wrap {
      @include home-wrap;
      display: grid;
      gap: 24px;
      align-items: start;

      @include respond-to("lg") {
        grid-template-columns: 1.5fr 1fr;
        gap: 32px;
      }
    }

    // ---------- formularz ----------
    &__form {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 28px 24px;
      background: #ffffff;
      border-radius: 28px;

      @include respond-to("md") {
        padding: 48px;
      }
    }

    &__form-title,
    &__card-title {
      @include heading-reset;
      font-family: $font-family-heading;
      font-weight: 600;
      font-size: 24px;
      color: $color-primary;
    }

    &__card-title {
      font-size: 20px;
    }

    &__row {
      display: grid;
      gap: 20px;

      @include respond-to("sm") {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    &__field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    &__label {
      font-size: 15px;
      font-weight: 500;
      color: $color-primary;
    }

    &__input {
      width: 100%;
      min-height: 52px;
      padding: 12px 18px;
      font: inherit;
      font-size: 17px;
      color: $color-primary;
      background: $home-grey;
      border: 1.5px solid transparent;
      border-radius: 16px;
      transition: border-color $transition-base, background $transition-base;

      &:hover {
        border-color: $home-line;
      }

      &:focus {
        outline: none;
        border-color: $color-accent;
        background: #ffffff;
      }

      &:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.25);
        outline-offset: 1px;
      }
    }

    &__textarea {
      min-height: 160px;
      resize: vertical;
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 20px;
      margin-top: 4px;
    }

    &__submit {
      @include home-button-dark;
      padding: 14px 26px;
    }

    &__hint {
      margin: 0;
      font-size: 13px;
      color: $home-muted;
    }

    // ---------- karty obok ----------
    &__info {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    &__card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 28px 24px;
      background: #ffffff;
      border-radius: $home-radius;

      @include respond-to("md") {
        padding: 32px;
      }

      &--dark {
        background: $color-primary;
        gap: 8px;
      }
    }

    &__card-label {
      margin: 0;
      font-size: 15px;
      font-weight: 500;
      color: #aab4c8;
    }

    &__mail {
      font-family: $font-family-heading;
      font-weight: 600;
      font-size: 22px;
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      overflow-wrap: anywhere;

      @include respond-to("md") {
        font-size: 26px;
      }

      &:hover {
        color: $home-yellow;
      }
    }

    &__topics,
    &__socials {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;

      li {
        font-size: 15px;
        word-spacing: 0.14em;
      }
    }

    &__social {
      color: $color-primary;
      font-weight: 500;

      &:hover {
        color: $color-accent;
      }
    }

    &__phones {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    &__phone-item {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 6px 16px;
      padding: 12px 0;

      & + & {
        border-top: 1px solid $home-line;
      }
    }

    &__phone-who {
      font-size: 17px;
      font-weight: 600;
      color: $color-primary;
    }

    &__phone {
      font-family: $font-family-heading;
      font-weight: 600;
      font-size: 18px;
      color: $color-primary;
      text-decoration: none;
      white-space: nowrap;

      &:hover {
        color: $color-accent;
      }
    }
  }
</style>
