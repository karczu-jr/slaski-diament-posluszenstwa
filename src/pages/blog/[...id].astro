---
// src/pages/blog/[...id].astro
import Layout from "../../layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import BackButton from "../../components/BackButton.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const imageUrl = post.data.image?.url;
const imageAlt = post.data.image?.alt || post.data.title;
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="post-details">
    <div class="post-details__header-actions">
      <BackButton fallbackHref="/blog" />
    </div>

    <header class="post-details__header">
      <div class="post-details__header-info">
        <h1 class="post-details__title">
          {post.data.title}
        </h1>
        <p class="post-details__description">{post.data.description}</p>
        <p class="post-details__date">
          <FormattedDate date={post.data.date} />
        </p>
      </div>
    </header>

    {
      imageUrl && (
        <div class="post-details__image-wrapper">
          <img
            src={imageUrl}
            alt={imageAlt}
            class="post-details__image"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <article class="post-details__content">
      <Content />
    </article>
  </div>
</Layout>

<style lang="scss">
  @use "sass:color";
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;
  @use "../../styles/typography" as *;

  .post-details {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 4.5rem;

    &__header-actions {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }

    &__header {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px dashed color.mix($color-text, $color-bg, 30%);

      @include respond-to('md') {
        flex-direction: row;
        align-items: center;
      }
    }

    &__header-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 36rem;
    }

    &__title {
      font-size: 1.875rem;
      // font-weight: 800;
      text-transform: uppercase;
      line-height: 1.2;
      color: $color-primary;

      @include respond-to('md') {
        font-size: 3rem;
      }
    }

    &__description {
      font-size: 1.125rem;
      line-height: 1.6;
      color: $color-text;
    }

    &__date {
      color: color.mix($color-text, $color-bg, 70%);
      font-weight: 500;
    }

    &__image-wrapper {
      width: 100%;
      aspect-ratio: 610 / 400;
      border-radius: 1rem;
      overflow: hidden;
      margin-top: 2rem;
      margin-bottom: 2rem;

      @include respond-to('lg') {
        height: 70vh;
        aspect-ratio: auto;
      }
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    &__content {
      max-width: 48rem;
      margin: 0 auto 4.5rem;
      padding: 0 0.75rem;
      font-size: 1.125rem;
      line-height: 1.7;
      color: $color-text;

      // Stylizowanie treści generowanej z plików Markdown (MDX)
      :global(h2) {
        font-size: 2rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }

      :global(p) {
        margin-bottom: 1.25rem;
      }
    }
  }
</style>