---
// src/pages/blog/[...id].astro
// Strona pojedynczego newsa: nagłówek, szeroki baner 21:9, treść MDX, galeria i "Czytaj także".
import ProseImage from "../../components/ProseImage.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BackButton from "../../components/BackButton.astro";
import Gallery from "../../components/Gallery.astro";
import NewsCard from "../../components/NewsCard.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

  return posts.map((post) => ({
    params: { id: post.id },
    props: {
      post,
      // Do sekcji "Czytaj także": 3 najnowsze wpisy poza bieżącym
      related: posts.filter((p) => p.id !== post.id).slice(0, 3),
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  related: CollectionEntry<"blog">[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, date, time, tags, image, gallery } = post.data;

const formattedDate = date
  ? date.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" })
  : null;

// Szacowany czas czytania (~200 słów na minutę)
const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));
---

<Layout title={title} description={description}>
  <div class="news-article">
    <div class="news-article__back">
      <BackButton fallbackHref="/blog" />
    </div>

    <header class="news-article__header">
      <p class="news-article__meta">
        {tags?.map((tag) => <span class="news-article__tag">{tag}</span>)}
        {
          formattedDate && (
            <time datetime={date?.toISOString()}>
              {formattedDate}
              {time && `, ${time}`}
            </time>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min czytania</span>
      </p>

      <h1 class="news-article__title">{title}</h1>

      {description && <p class="news-article__lead">{description}</p>}
    </header>

    {
      image?.url && (
        <div class="news-article__cover">
          <Image
            src={image.url}
            alt={image.alt || title}
            widths={[640, 1024, 1600, 2000]}
            sizes="(min-width: 1280px) 1232px, 100vw"
            class="news-article__cover-image"
            loading="eager"
          />
        </div>
      )
    }

    <article class="news-article__content">
      <Content components={{ img: ProseImage }} />
    </article>

    {
      gallery && gallery.length > 0 && (
        <div class="news-article__gallery">
          <Gallery images={gallery} fallbackAlt={`Zdjęcie – ${title}`} />
        </div>
      )
    }

    {
      related.length > 0 && (
        <section class="news-article__related" aria-labelledby="related-heading">
          <div class="news-article__related-header">
            <h2 id="related-heading" class="news-article__related-title">
              Czytaj także
            </h2>
            <ButtonSecondary href="/blog" text="Wszystkie newsy" />
          </div>
          <ul class="news-article__related-grid" role="list">
            {related.map((item) => (
              <li class="news-article__related-item">
                <NewsCard entry={item} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Layout>

<style lang="scss">
  @use "sass:color";
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;
  @use "../../styles/prose" as *;

  $dashed: 1px dashed color.mix($color-text, $color-bg, 30%);

  .news-article {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem;

    &__back {
      margin: 1.5rem 0;
    }

    // ---------- Nagłówek ----------
    &__header {
      max-width: 52rem;
      margin: 0 auto 2rem;
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin: 0 0 1.25rem;
      font-size: 0.9rem;
      color: color.mix($color-text, $color-bg, 75%);
    }

    &__tag {
      padding: 0.2rem 0.65rem;
      font-family: $font-family-heading;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: $color-accent;
      background: color.mix($color-accent, $color-bg, 10%);
      border-radius: 999px;
    }

    &__title {
      margin: 0 0 1.25rem;
      font-size: 2rem;
      line-height: 1.15;
      text-transform: none;

      @include respond-to("md") {
        font-size: 3rem;
      }
    }

    &__lead {
      margin: 0;
      font-size: 1.2rem;
      line-height: 1.6;
      color: $color-text;

      @include respond-to("md") {
        font-size: 1.35rem;
      }
    }

    // ---------- Baner (szeroki, ale niski – jak w edycjach zawodów) ----------
    &__cover {
      width: 100%;
      aspect-ratio: 3 / 2;
      margin: 0 0 3rem;
      overflow: hidden;
      border-radius: 1rem;
      background: color.mix($color-text, $color-bg, 6%);

      @include respond-to("md") {
        aspect-ratio: 21 / 9;
      }
    }

    &__cover-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    // ---------- Treść ----------
    &__content {
      max-width: 52rem;
      margin: 0 auto;
      font-size: 1.125rem;
      line-height: 1.7;
      color: $color-text;

      @include prose;
    }

    &__gallery {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: $dashed;
    }

    // ---------- Czytaj także ----------
    &__related {
      margin-top: 4.5rem;
      padding-top: 3rem;
      border-top: $dashed;
    }

    &__related-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    &__related-title {
      margin: 0;
      font-size: 1.75rem;
      text-transform: none;
    }

    &__related-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin: 0;
      padding: 0;
      list-style: none;

      @include respond-to("sm") {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @include respond-to("lg") {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
      }
    }

    &__related-item {
      margin: 0;
      padding: 0;

      &::before {
        content: none;
      }
    }
  }
</style>
