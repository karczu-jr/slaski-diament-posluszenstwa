---
// src/pages/blog/[...id].astro
// Pojedynczy news (wersja 5): powrót do listy, nagłówek (kategoria, data, czas czytania),
// okładka w naturalnych proporcjach, treść MDX, galeria, "Czytaj także" i zapis na powiadomienia.
import Layout from "../../layouts/Layout.astro";
import ProseImage from "../../components/ProseImage.astro";
import Gallery from "../../components/Gallery.astro";
import NewsCard from "../../components/NewsCard.astro";
import HomeSignup from "../../components/home/HomeSignup.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

  return posts.map((post) => ({
    params: { id: post.id },
    props: {
      post,
      // "Czytaj także": 3 najnowsze wpisy poza bieżącym
      related: posts.filter((p) => p.id !== post.id).slice(0, 3),
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  related: CollectionEntry<"blog">[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, date, time, tags, image, gallery } = post.data;

const formattedDate = date?.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });

// Szacowany czas czytania (~200 słów na minutę)
const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));
---

<Layout title={title} description={description ?? title} image={image?.url.src}>
  <div class="article">
    <article>
      <header class="article__header">
        <a href="/blog" class="article__back"><span class="article__back-icon" aria-hidden="true">👈</span> Wszystkie newsy</a>

        <p class="article__meta">
          {tags?.[0] && <span class="article__tag">{tags[0]}</span>}
          {
            date && (
              <time datetime={date.toISOString()}>
                {formattedDate}
                {time && `, ${time}`}
              </time>
            )
          }
          <span aria-hidden="true">·</span>
          <span>{readingMinutes} min czytania</span>
        </p>

        <h1 class="article__title">{title}</h1>
        {description && <p class="article__lead">{description}</p>}
      </header>

      {
        image?.url && (
          <figure class="article__cover">
            <Image
              src={image.url}
              alt={image.alt || title}
              widths={[480, 832, 1248, 1664]}
              sizes="(min-width: 900px) 832px, 100vw"
              class="article__cover-img"
              loading="eager"
            />
          </figure>
        )
      }

      <div class="article__content">
        <Content components={{ img: ProseImage }} />
      </div>

      {
        gallery && gallery.length > 0 && (
          <div class="article__gallery">
            <Gallery images={gallery} fallbackAlt={`Zdjęcie – ${title}`} />
          </div>
        )
      }
    </article>

    {
      related.length > 0 && (
        <section class="article__related" aria-labelledby="related-title">
          <div class="article__related-wrap">
            <div class="article__related-head">
              <div>
                <p class="article__related-eyebrow">📰 Newsy</p>
                <h2 id="related-title" class="article__related-title">Czytaj także</h2>
              </div>
              <a href="/blog" class="article__related-all">
                Wszystkie newsy <span class="nudge" aria-hidden="true">👉</span>
              </a>
            </div>
            <ul class="article__related-grid" role="list">
              {related.map((item) => (
                <li>
                  <NewsCard entry={item} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <HomeSignup tone="white" />
  </div>
</Layout>

<style lang="scss">
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;
  @use "../../styles/home" as *;
  @use "../../styles/prose" as *;

  .article {
    background: #ffffff;
    font-size: 17px;
    line-height: 1.6;

    // Wąska kolumna do czytania – ok. 70 znaków w linii
    &__header,
    &__cover,
    &__content {
      max-width: 832px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;

      @include respond-to("md") {
        padding-left: 24px;
        padding-right: 24px;
        box-sizing: content-box;
      }
    }

    &__header {
      padding-top: 112px;
      padding-bottom: 32px;

      @include respond-to("md") {
        padding-top: 136px;
        padding-bottom: 40px;
      }
    }

    &__back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 44px;
      margin-bottom: 20px;
      font-size: 15px;
      font-weight: 500;
      color: $color-primary;
      text-decoration: none;
      word-spacing: 0.14em;

      &:hover {
        color: $color-accent;
      }
    }

    // Strzałka powrotu przesuwa się w lewo – lustrzane odbicie animacji 👉
    &__back-icon {
      display: inline-block;
      transition: transform $transition-base;

      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }

    &__back:hover &__back-icon,
    &__back:focus-visible &__back-icon {
      transform: translateX(-4px);

      @media (prefers-reduced-motion: reduce) {
        transform: none;
      }
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 10px;
      margin: 0 0 16px;
      font-size: 14px;
      color: $home-muted;
    }

    &__tag {
      font-family: $font-family-heading;
      font-size: 12px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: $color-accent;
      background: $home-accent-soft;
      padding: 3px 10px;
      border-radius: 999px;
    }

    &__title {
      @include home-h2;
      font-weight: 600;
      font-size: 30px;
      line-height: 1.2;

      @include respond-to("md") {
        font-size: 44px;
      }
    }

    &__lead {
      margin: 20px 0 0;
      font-size: 18px;
      line-height: 1.55;
      color: #3f3f46;

      @include respond-to("md") {
        font-size: 20px;
      }
    }

    // Okładka w naturalnych proporcjach (grafiki z tekstem nie są przycinane)
    &__cover {
      margin-top: 0;
      margin-bottom: 40px;
    }

    &__cover-img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 720px;
      object-fit: contain;
      border-radius: $home-radius;
      background: $home-grey;
    }

    // Treść MDX
    &__content {
      padding-bottom: 72px;
      font-size: 17px;
      color: $home-text;

      @include respond-to("md") {
        font-size: 18px;
        padding-bottom: 96px;
      }

      @include prose;

      :global(p) {
        margin: 0 0 1.1em;
        line-height: 1.75;
      }

      :global(h2) {
        @include heading-reset;
        margin: 2em 0 0.75em;
        font-family: $font-family-heading;
        font-weight: 600;
        font-size: 22px;
        line-height: 1.25;
        color: $color-primary;

        @include respond-to("md") {
          font-size: 26px;
        }
      }

      :global(h3) {
        @include heading-reset;
        margin: 1.6em 0 0.6em;
        font-family: $font-family-heading;
        font-weight: 600;
        font-size: 19px;
        color: $color-primary;
      }

      :global(a) {
        color: $color-accent;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        overflow-wrap: anywhere;

        &:hover {
          color: $color-primary;
        }
      }

      :global(img) {
        max-height: none;
        border-radius: $home-radius;
      }

      :global(ul),
      :global(ol) {
        margin: 0 0 1.25em;
        padding: 0;
      }

      :global(blockquote) {
        margin: 1.5em 0;
        padding: 16px 24px;
        border-left: 4px solid $home-yellow;
        background: $home-grey;
        border-radius: 0 16px 16px 0;
      }
    }

    &__gallery {
      max-width: 1280px;
      margin: -24px auto 0;
      padding: 0 24px 72px;

      @include respond-to("md") {
        padding: 0 24px 96px;
      }
    }

    // Czytaj także – szare tło jak newsy na stronie głównej
    &__related {
      background: $home-grey;
    }

    &__related-wrap {
      @include home-wrap;
    }

    &__related-head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px 24px;
      margin-bottom: 36px;
    }

    &__related-eyebrow {
      @include home-eyebrow;
    }

    &__related-title {
      @include home-h2;
    }

    &__related-all {
      @include home-pill;
    }

    &__related-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 24px;

      @include respond-to("sm") {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @include respond-to("lg") {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      > li {
        display: flex;
      }
    }
  }
</style>
