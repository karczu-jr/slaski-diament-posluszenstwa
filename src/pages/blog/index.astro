---
// src/pages/blog/index.astro
// Lista wszystkich newsów: wyróżniony najnowszy wpis + siatka pogrupowana po latach.
import Layout from "../../layouts/Layout.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { BLOG } from "../../consts";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

const [featured, ...rest] = posts;

// Grupowanie pozostałych wpisów po roku (wpisy bez daty trafiają na koniec)
const NO_DATE = "Bez daty";
const groups = new Map<string, CollectionEntry<"blog">[]>();
for (const post of rest) {
  const key = post.data.date ? String(post.data.date.getFullYear()) : NO_DATE;
  groups.set(key, [...(groups.get(key) ?? []), post]);
}
const years = [...groups.keys()].sort((a, b) =>
  a === NO_DATE ? 1 : b === NO_DATE ? -1 : Number(b) - Number(a)
);

const countLabel = (n: number) => {
  if (n === 1) return "1 wpis";
  const lastTwo = n % 100;
  const last = n % 10;
  const few = last >= 2 && last <= 4 && (lastTwo < 12 || lastTwo > 14);
  return `${n} ${few ? "wpisy" : "wpisów"}`;
};
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <section class="news-page" aria-labelledby="news-heading">
    <header class="news-page__header">
      <div class="news-page__heading">
        <h1 id="news-heading" class="news-page__title">Newsy</h1>
        <span class="news-page__count">{countLabel(posts.length)}</span>
      </div>
      <p class="news-page__lead">
        Ogłoszenia, wyniki i relacje z zawodów Śląskiego Diamentu Posłuszeństwa.
      </p>
    </header>

    {
      featured ? (
        <div class="news-page__body">
          <NewsCard entry={featured} variant="featured" />

          {years.map((year) => (
            <section class="news-page__group" aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`} class="news-page__year">
                {year}
                <span class="news-page__year-count">{countLabel(groups.get(year)!.length)}</span>
              </h2>
              <ul class="news-page__grid" role="list">
                {groups.get(year)!.map((post) => (
                  <li class="news-page__item">
                    <NewsCard entry={post} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p class="news-page__empty">Wkrótce pojawią się tu pierwsze newsy.</p>
      )
    }
  </section>
</Layout>

<style lang="scss">
  @use "sass:color";
  @use "../../styles/variables" as *;
  @use "../../styles/mixins" as *;

  .news-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 6.5rem 1.5rem 4.5rem;

    &__header {
      max-width: 48rem;
      margin-bottom: 2.5rem;

      @include respond-to("md") {
        margin-bottom: 3.5rem;
      }
    }

    // Nagłówek z licznikiem wpisów obok, wyrównanym do linii bazowej tytułu
    &__heading {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 1rem;
      margin-bottom: 1rem;
    }

    &__title {
      margin: 0;
      font-size: 3rem;
      line-height: 1;

      @include respond-to("md") {
        font-size: 5rem;
      }

      @include respond-to("lg") {
        font-size: 6.5rem;
      }
    }

    &__count {
      font-family: $font-family-heading;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;
      color: $color-accent;

      @include respond-to("md") {
        font-size: 1.1rem;
      }
    }

    &__lead {
      margin: 0;
      font-size: 1.125rem;
      line-height: 1.6;
      color: $color-text;

      @include respond-to("md") {
        font-size: 1.25rem;
      }
    }

    &__body {
      display: flex;
      flex-direction: column;
      gap: 3rem;

      @include respond-to("md") {
        gap: 4rem;
      }
    }

    &__group {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    &__year {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin: 0;
      padding-bottom: 0.75rem;
      font-size: 1.75rem;
      border-bottom: 1px dashed color.mix($color-text, $color-bg, 25%);

      @include respond-to("md") {
        font-size: 2.25rem;
      }
    }

    &__year-count {
      font-family: $font-family-body;
      font-size: 0.9rem;
      font-weight: 400;
      text-transform: none;
      letter-spacing: 0;
      color: color.mix($color-text, $color-bg, 70%);
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin: 0;
      padding: 0;
      list-style: none;

      @include respond-to("sm") {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @include respond-to("lg") {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
      }
    }

    &__item {
      margin: 0;
      padding: 0;

      &::before {
        content: none;
      }
    }

    &__empty {
      color: $color-text;
    }
  }
</style>
