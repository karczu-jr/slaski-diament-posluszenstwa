---
// src/pages/blog/index.astro
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { BLOG } from "../../consts";

const data = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
    [year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
    const year = post.data.date.getFullYear().toString();
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(post);
    return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
    <section id="blog" class="blog-page" aria-labelledby="blog-heading">
        <h1 id="blog-heading" class="blog-page__title">
            Blog
        </h1>

        <div class="blog-page__sections">
            {
                years.map((year) => (
                    <section class="blog-page__year-group" aria-labelledby={`year-${year}`}>
                        <h2 id={`year-${year}`} class="blog-page__year-title">{year}</h2>
                        <ul class="blog-page__list" role="list">
                            {posts[year].map((post) => (
                                <li class="blog-page__item">
                                    <Card entry={post} />
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>
    </section>
</Layout>

<style lang="scss">
    @use "sass:color";
    @use "../../styles/variables" as *;
    @use "../../styles/mixins" as *;

    .blog-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 4.5rem 1.5rem 4.5rem;

        &__title {
            font-size: 3rem;
            font-weight: 800;
            text-transform: uppercase;
            color: $color-primary;
            margin-top: 2rem;
            margin-bottom: 2rem;
            line-height: 1;

            @include respond-to('md') {
                font-size: 6rem;
            }

            @include respond-to('lg') {
                font-size: 8rem;
            }
        }

        &__sections {
            display: flex;
            flex-direction: column;
            gap: 3rem;
        }

        &__year-group {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        &__year-title {
            // font-size: 1.5rem;
            // font-weight: 700;
            color: color.mix($color-text, $color-bg, 80%);
            border-bottom: 1px dashed color.mix($color-text, $color-bg, 20%);
            padding-bottom: 0.5rem;

            @include respond-to('lg') {
                font-size: 2.25rem;
            }
        }

        &__list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        &__item {
            margin: 0;
            padding: 0;
        }
    }
</style>